<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\CustomerData\Customer">
        <plugin name="LogrocketCustomerInfo" type="JustBetter\SentryLogrocket\Plugin\LogrocketCustomerInfo"
                sortOrder="10" disabled="false"/>
    </type>

    <!-- Content Security Policies -->
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="sentry_logrocket" xsi:type="object" sortOrder="100">JustBetter\SentryLogrocket\Model\Collector\LogrocketCspCollector\Proxy</item>
            </argument>
        </arguments>
    </type>
</config>
