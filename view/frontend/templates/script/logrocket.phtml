        });
    });',
    false
); ?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $block->getLayout()->createBlock(\JustBetter\SentryLogrocket\Block\LogrocketScript::class)
    ->setTemplate('JustBetter_SentryLogrocket::script/logrocket_init.phtml')
    ->toHtml(), false); ?>
